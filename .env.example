# App
APP_NAME=VNS Analytics
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Postgres
POSTGRES_USER=vns
POSTGRES_PASSWORD=vns_secret
POSTGRES_DB=vns
DATABASE_URL=postgresql+asyncpg://vns:vns_secret@db:5432/vns

# Redis
REDIS_URL=redis://redis:6379/0

# Upstox (never commit real values)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/upstox/callback
UPSTOX_BASE_URL=https://api.upstox.com/v2

# Sync
OHLC_SYNC_INTERVAL_MINUTES=15
VNS_DEFAULT_TIMEFRAME=day
